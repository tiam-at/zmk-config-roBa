#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1>;
            label = "TO_LAYER_0";
        };

        rogu_pass: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMBER_1 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_8 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp RETURN &kp LG(LS(UP_ARROW)) &kp DEL>;
            label = "NEW_MACRO";
        };

        line_pass: rine_pass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp A &kp S &kp A &kp K &kp I &kp KP_NUMBER_0 &kp KP_NUMBER_2 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp RET &kp LG(LS(UP_ARROW)) &kp DELETE>;
            label = "RINE_PASS";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LEFT_CONTROL Q  &kp W           &kp E                 &kp R       &kp T                                  &kp Y    &kp U  &kp I      &kp O    &kp P
&mt LEFT_SHIFT A    &kp S           &lt 2 D               &lt 5 F     &kp G      &trans       &trans         &kp H    &kp J  &kp K      &lt 5 L  &lt 1 SEMICOLON
&mt LEFT_SHIFT Z    &kp X           &kp C                 &kp V       &kp B      &trans       &trans         &kp N    &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_COMMAND    &kp LEFT_SHIFT  &kp RC(LEFT_CONTROL)  &kp ESCAPE  &kp SPACE  &kp TAB      &kp BACKSPACE  &kp RET                             &kp DEL
            >;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &mkp MB2  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F6    &mkp LCLK  &mkp RCLK  &mo 5   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB1  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                  &trans
            >;
        };

        NUM {
            bindings = <
&trans  &kp C_VOLUME_DOWN  &trans      &kp C_VOLUME_UP  &trans                            &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS
&trans  &kp F14            &trans      &kp F15          &trans  &trans      &trans        &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS
&trans  &line_pass         &rogu_pass  &trans           &trans  &trans      &trans        &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_EQUAL
&trans  &trans             &trans      &trans           &trans  &trans      &kp ASTERISK  &kp SLASH                                                           &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &kp LA(LG(LEFT_ARROW))  &kp UP_ARROW    &kp LA(LG(RIGHT))  &trans                      &kp LS(NUMBER_4)  &kp EXCLAMATION  &kp LS(LEFT_PARENTHESIS)  &kp LS(RIGHT_PARENTHESIS)  &kp MINUS
&trans  &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT          &trans  &trans      &trans  &kp AMPERSAND     &kp LS(AT_SIGN)  &kp LS(LEFT_BRACE)        &kp LS(RIGHT_BRACE)        &lt 1 EQUAL
&trans  &kp LC(LG(LEFT_ARROW))  &trans          &kp LC(LG(RIGHT))  &trans  &trans      &trans  &trans            &trans           &kp LESS_THAN             &kp GREATER_THAN           &kp SLASH
&trans  &trans                  &trans          &trans             &trans  &trans      &trans  &trans                                                                                  &kp LS(LG(NUMBER_4))
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
